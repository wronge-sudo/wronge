# ─────────────────────────────────────────────────────────────
#  WRONGE — environment variables
#  Copy this file to `.env.local` and fill in the blanks.
#  NEVER commit .env.local (it is already in .gitignore).
# ─────────────────────────────────────────────────────────────

# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://mjuhwkjibqrtguvazaro.supabase.co
# "Publishable key" (starts with sb_publishable_) — safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (starts with sb_secret_) — SERVER ONLY, keep private
SUPABASE_SECRET_KEY=

# Cloudinary → Settings → API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=pjuy9s06
CLOUDINARY_API_KEY=455431237698383
# Click the eye icon next to the Root key to reveal it — SERVER ONLY
CLOUDINARY_API_SECRET=
